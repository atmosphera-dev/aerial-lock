#!/bin/sh
# Compatibility frontend. The companion alone owns acquisition and settings.
set -eu

usage() {
    cat >&2 <<'EOF'
usage: aerial-lock-fetch [--limit N]

Fetch configured remote sources through aerialctl fetch --wait.
  --limit N     ready clips per source; 0 (default) means no item limit.
  -h, --help    this text.

Manual fetch bypasses automatic network, power and quality policy, not source
resolution bands, cache limits, TLS or validation. Completed clips play from
the next lock. Exit: 0 ready, 1 no ready clip/operation failure, 2 bad arguments.
EOF
}

limit=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --limit)
            [ "$#" -ge 2 ] || { usage; exit 2; }
            case "$2" in
                ''|*[!0-9]*) usage; exit 2 ;;
            esac
            limit=$2
            shift 2
            ;;
        -h|--help) usage; exit 0 ;;
        *) usage; exit 2 ;;
    esac
done

command -v aerialctl >/dev/null 2>&1 || {
    echo 'aerial-lock-fetch: aerialctl is not installed or is not in PATH' >&2
    exit 1
}
exec aerialctl fetch --wait --limit "$limit"
