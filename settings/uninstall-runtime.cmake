# The receipt follows the installed settings payload, not any build checkout.
set(MANIFEST "$ENV{DESTDIR}${LICENSE_ROOT}/install-manifest.txt")
if(EXISTS "${MANIFEST}")
    file(STRINGS "${MANIFEST}" files)
    list(FIND files "${BINDIR}/aerial-settings" executable)
    if(executable EQUAL -1)
        message(FATAL_ERROR "Private runtime manifest belongs to another executable layout: ${MANIFEST}")
    endif()
    foreach(path IN LISTS files)
        if(NOT IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.(/|$)")
            message(FATAL_ERROR "Invalid private runtime manifest entry: ${path}")
        endif()
        string(FIND "${path}" "${INTERACTIVE_ROOT}/" in_runtime)
        string(FIND "${path}" "${LICENSE_ROOT}/" in_licenses)
        if(NOT path STREQUAL "${BINDIR}/aerial-settings" AND NOT in_runtime EQUAL 0 AND NOT in_licenses EQUAL 0)
            message(FATAL_ERROR "Private runtime manifest belongs to another install layout: ${path}")
        endif()
    endforeach()
    foreach(path IN LISTS files)
        file(REMOVE "$ENV{DESTDIR}${path}")
    endforeach()
    file(REMOVE "${MANIFEST}")
elseif(EXISTS "$ENV{DESTDIR}${BINDIR}/aerial-settings"
        OR EXISTS "$ENV{DESTDIR}${INTERACTIVE_ROOT}/lib/libinteractive_foundation.so"
        OR EXISTS "$ENV{DESTDIR}${LICENSE_ROOT}/COPYING")
    message(FATAL_ERROR "Missing private runtime install manifest: ${MANIFEST}")
endif()
