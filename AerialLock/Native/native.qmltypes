import QtQuick.tooling 1.2

Module {
    Component {
        name: "LocalContent"
        prototype: "QObject"
        exports: ["AerialLock.Native/LocalContent 1.0"]
        Property { name: "generation"; type: "QString"; isReadonly: true }
        Signal { name: "changed" }
        Method {
            name: "freeze"
            Parameter { name: "cacheRoot"; type: "QString" }
            Parameter { name: "stateRoot"; type: "QString" }
            Parameter { name: "sources"; type: "QVariantList" }
        }
        Method { name: "forSource"; type: "QVariantList"; Parameter { name: "sourceId"; type: "QString" } }
        Method { name: "lookup"; type: "QVariantMap"; Parameter { name: "path"; type: "QString" } }
        Method { name: "reportPlayback"; Parameter { name: "path"; type: "QString" } }
    }
    Component {
        name: "LocalConfig"
        prototype: "QObject"
        exports: ["AerialLock.Native/LocalConfig 1.0"]
        Property { name: "data"; type: "QVariantMap"; isReadonly: true }
        Property { name: "rawUser"; type: "QVariantMap"; isReadonly: true }
        Property { name: "diagnostics"; type: "QStringList"; isReadonly: true }
        Property { name: "profile"; type: "QString"; isReadonly: true }
        Property { name: "revision"; type: "QString"; isReadonly: true }
        Property { name: "ready"; type: "bool"; isReadonly: true }
        Signal { name: "changed" }
        Method {
            name: "load"; type: "bool"
            Parameter { name: "bundle"; type: "QString" }
            Parameter { name: "userPath"; type: "QString" }
        }
    }
    Component {
        name: "PowerActions"
        prototype: "QObject"
        exports: ["AerialLock.Native/PowerActions 1.0"]
        Property { name: "enabled"; type: "bool" }
        Property { name: "secure"; type: "bool" }
        Property { name: "canSuspend"; type: "bool"; isReadonly: true }
        Property { name: "canHibernate"; type: "bool"; isReadonly: true }
        Property { name: "canReboot"; type: "bool"; isReadonly: true }
        Property { name: "canPowerOff"; type: "bool"; isReadonly: true }
        Property { name: "suspendReason"; type: "QString"; isReadonly: true }
        Property { name: "hibernateReason"; type: "QString"; isReadonly: true }
        Property { name: "rebootReason"; type: "QString"; isReadonly: true }
        Property { name: "powerOffReason"; type: "QString"; isReadonly: true }
        Property { name: "state"; type: "QString"; isReadonly: true }
        Property { name: "pendingAction"; type: "QString"; isReadonly: true }
        Property { name: "activeAction"; type: "QString"; isReadonly: true }
        Property { name: "blockerWho"; type: "QString"; isReadonly: true }
        Property { name: "blockerWhy"; type: "QString"; isReadonly: true }
        Property { name: "confirmationRequired"; type: "bool"; isReadonly: true }
        Property { name: "busy"; type: "bool"; isReadonly: true }
        Property { name: "interactionActive"; type: "bool"; isReadonly: true }
        Property { name: "errorCode"; type: "QString"; isReadonly: true }
        Signal { name: "changed" }
        Method { name: "request"; Parameter { name: "action"; type: "QString" } }
        Method { name: "confirm" }
        Method { name: "cancel" }
        Method { name: "clearError" }
        Method { name: "refresh" }
    }
    Component {
        name: "AuthContext"
        prototype: "QObject"
        exports: ["AerialLock.Native/AuthContext 1.0"]
        Enum { name: "Result"; values: { "Success": 0, "Failed": 1, "Error": 2, "MaxTries": 3 } }
        Property { name: "config"; type: "QString" }
        Property { name: "configDirectory"; type: "QString" }
        Property { name: "user"; type: "QString" }
        Property { name: "active"; type: "bool"; isReadonly: true }
        Property { name: "message"; type: "QString"; isReadonly: true }
        Property { name: "messageIsError"; type: "bool"; isReadonly: true }
        Property { name: "responseRequired"; type: "bool"; isReadonly: true }
        Property { name: "responseVisible"; type: "bool"; isReadonly: true }
        Signal { name: "pamMessage" }
        Signal { name: "completed"; Parameter { name: "result"; type: "int" } }
        Signal { name: "error"; Parameter { name: "error"; type: "int" } }
        Method { name: "start"; type: "bool" }
        Method { name: "abort" }
        Method { name: "respond"; Parameter { name: "response"; type: "QString" } }
    }
}
