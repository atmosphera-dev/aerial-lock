{
  "language": "en",
  "backgroundColor": "#000000",
  "theme": "Macintosh.qml",
  "sources": [
    {
      "id": "apple-tv",
      "type": "apple",
      "name": "Apple TV",
      "source": "https://sylvan.apple.com/itunes-assets/Aerials126/v4/c0/45/d9/c045d9d0-9606-1535-62fe-189edb4f79eb/resources-atv-23J-2.tar"
    }
  ],
  "acquisition": {
    "automatic": {
      "enabled": true,
      "allowedResolutions": [1080],
      "allowMetered": false,
      "connectionTypes": {
        "ethernet": true, "wifi": true, "cellular": true,
        "bluetooth": true, "vpn": true, "other": true, "unknown": true
      },
      "power": { "ac": true, "battery": true, "unknown": true }
    },
    "checkIntervalSeconds": 3600
  },
  "cache": {
    "maxBytes": 10000000000,
    "rotationDays": 7,
    "minFreeBytes": 0
  },
  "pamService": "aerial-lock",
  "fallbackQuitMs": 3000,
  "pamWatchdogTimeoutMs": 60000,
  "powerActions": {
    "enabled": true
  },
  "idle": {
    "timeoutSeconds": 0,
    "respectInhibitors": true,
    "lockOnSuspend": true,
    "logindLockUnlock": true
  },
  "panel": {
    "widthMax": 360,
    "fieldHeight": 40,
    "radius": 12,
    "fieldRadius": 8,
    "outerMargin": 20,
    "spacing": 12,
    "fontSize": 16
  },
  "colors": {
    "text": "#dddddd",
    "textError": "#ff5555",
    "input": "#ffffff",
    "panelFill": "#14ffffff",
    "panelBorder": "#1fffffff",
    "fieldFill": "#0fffffff",
    "fieldBorderFocused": "#40ffffff",
    "fieldBorder": "#1affffff"
  }
}
